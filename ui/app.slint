export struct LinkSegmentVm {
    arrow: int, segment: int,
    x: length, y: length, w: length, h: length,
    selected: bool, eligible: bool, reason: string,
}

export struct ArrowVm {
    x: length,
    y: length,
    w: length,
    h: length,
    commands: string,
    color: color,
    hovered: bool,
}

export struct NodeVm {
    id: string,
    x: length,
    y: length,
    w: length,
    h: length,
    img: image,
    error: string,
    selected: bool,
    // Inside the selection rectangle being dragged.
    marquee: bool,
}

// One cell of the table grid editor. r is the grid row (after span
// placement); x and w are the horizontal position and width in canvas units,
// already accounting for column widths and colspan. fill previews a hex fill.
export struct CellVm {
    r: int,
    x: float,
    w: float,
    text: string,
    fill: color,
    header: bool,
}

// Draggable divider at the right edge of column `col`, in canvas units.
export struct ColEdge {
    col: int,
    x: float,
}

// One tab in the page strip.
export struct PageTab {
    name: string,
    active: bool,
}

// Flat icon button for the toolbar. Built from scratch rather than on the
// std Button so the icon is exactly centered and the size is predictable.
component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> active: false;
    callback clicked;

    width: 30px;
    height: 30px;
    border-radius: 4px;
    background: root.active ? #bfdbfe : ta.pressed ? #cfcfcb : ta.has-hover ? #dededa : transparent;
    accessible-role: button;
    accessible-label: tip;

    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        colorize: #333;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    Tooltip {
        text: @markdown("\{root.tip}");
    }
}

export component MainWindow inherits Window {
    title: "mcanvas";
    preferred-width: 1200px;
    preferred-height: 800px;
    forward-focus: keys;

    in-out property <[NodeVm]> nodes;
    in-out property <[ArrowVm]> arrows;
    // 0 = select, 1 = straight arrow, 2 = orthogonal arrow, 3 = link middles.
    in-out property <int> connect-mode: 0;
    callback port-clicked(int, int);
    in-out property <[LinkSegmentVm]> link-segments;
    in-out property <int> link-step: 1;
    in-out property <int> link-hover: -1;
    in-out property <string> link-hint;
    callback link-pointer(length, length, bool);
    in-out property <length> pan-x: 0;
    in-out property <length> pan-y: 0;
    in-out property <float> zoom: 1.0;
    // Space is held on the canvas: dragging anywhere pans.
    in-out property <bool> space-pan;
    in-out property <int> edit-index: -1;
    in-out property <[CellVm]> edit-cells;
    in-out property <int> table-edit-index: -1;
    in-out property <[ColEdge]> edit-col-edges;
    in-out property <int> table-rows: 1;
    // Total table width in canvas units.
    in-out property <float> table-width: 320;
    in-out property <[PageTab]> pages;
    // Index of the tab being renamed inline, or -1.
    in-out property <int> rename-page: -1;
    in-out property <string> status-left;
    in-out property <string> status-right;
    out property <length> view-width: canvas.width;
    out property <length> view-height: canvas.height;
    // Mouse position over the canvas in view coordinates, valid while
    // pointer-in is true (also over nodes, unlike the background's hover).
    out property <bool> pointer-in: tracker.has-hover;
    out property <length> pointer-x: tracker.mouse-x;
    out property <length> pointer-y: tracker.mouse-y;

    callback node-pressed(int, bool);
    callback node-drag(int, length, length);
    callback node-drag-end(int);
    callback node-resize(int, length);
    callback node-resize-end(int);
    callback node-edit-request(int);
    // Node context menu: "edit", "copy", "copy-typst", "delete".
    callback node-menu(string, int);
    callback background-clicked(length, length);
    // Canvas-coordinate pointer position over the background; returns whether
    // a click there would select an arrow.
    callback canvas-pointer(length, length, bool) -> bool;
    // Shift+drag selection rectangle, in canvas coordinates: start, current.
    callback marquee-update(length, length, length, length);
    callback marquee-end(length, length, length, length, bool);
    callback marquee-cancel();
    callback background-double-clicked(length, length);
    // Background context menu "Paste here", at a point in canvas coordinates.
    callback paste-at(length, length);
    callback commit-edit(int, string);
    callback cancel-edit();
    callback table-cell-edited(int, string);
    // Grid editor context menu: operation name and the cell it was opened on.
    callback table-op(string, int);
    callback table-col-resize-start(int);
    callback table-col-resize(int, float);
    callback table-col-resize-end();
    callback commit-table-edit();
    callback cancel-table-edit();
    // Page actions: "select", "next", "prev", "add", "duplicate", "rename",
    // "move-left", "move-right", "delete". The int is a tab index, or -1 for
    // the active page. Call through page-action() so open edits are kept.
    callback page-op(string, int);
    callback page-renamed(int, string);
    callback key(string, bool, bool) -> bool;
    // Menu and toolbar actions, identified by name ("save", "zoom-fit", ...).
    callback command(string);

    public function begin-edit(i: int, text: string) {
        root.edit-index = i;
        edit-input.text = text;
        edit-input.focus();
    }
    public function end-edit() {
        root.edit-index = -1;
        keys.focus();
    }
    public function begin-table-edit(i: int) {
        root.table-edit-index = i;
        table-keys.focus();
    }
    public function end-table-edit() {
        root.table-edit-index = -1;
        keys.focus();
    }
    // Commit any open editor, then run a page action, so switching pages
    // never drops text typed into a node.
    public function page-action(op: string, i: int) {
        if (root.edit-index >= 0) {
            root.commit-edit(root.edit-index, edit-input.text);
        }
        if (root.table-edit-index >= 0) {
            root.commit-table-edit();
        }
        root.page-op(op, i);
    }
    public function focus-canvas() {
        keys.focus();
    }
    public function zoom-at(f: float, sx: length, sy: length) {
        root.pan-x = sx - (sx - root.pan-x) * f;
        root.pan-y = sy - (sy - root.pan-y) * f;
        root.zoom = root.zoom * f;
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "New"; shortcut: @keys(Control + N); activated => { root.command("new"); } }
            MenuItem { title: "Open..."; shortcut: @keys(Control + O); activated => { root.command("open"); } }
            MenuSeparator {}
            MenuItem { title: "Save"; shortcut: @keys(Control + S); activated => { root.command("save"); } }
            MenuItem { title: "Save As..."; shortcut: @keys(Control + Shift + S); activated => { root.command("save-as"); } }
            MenuSeparator {}
            MenuItem { title: "Quit"; shortcut: @keys(Control + Q); activated => { root.command("quit"); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; shortcut: @keys(Control + Z); activated => { root.command("undo"); } }
            MenuItem { title: "Redo"; shortcut: @keys(Control + Y); activated => { root.command("redo"); } }
            MenuSeparator {}
            // Ctrl+C and Ctrl+V are handled by the canvas key handler, not
            // declared here, so they keep working on text inside the editors.
            MenuItem { title: "Copy Node (Ctrl+C)"; activated => { root.command("copy"); } }
            MenuItem { title: "Paste (Ctrl+V)"; activated => { root.command("paste"); } }
            MenuSeparator {}
            MenuItem { title: "Add Node"; shortcut: @keys(Control + Shift + N); activated => { root.command("add-node"); } }
            MenuItem { title: "Add Table"; shortcut: @keys(Control + Shift + T); activated => { root.command("add-table"); } }
            MenuItem { title: "Edit Node"; activated => { root.command("edit-node"); } }
            MenuItem { title: "Straight Arrow"; activated => { root.command("arrow-straight"); } }
            MenuItem { title: "Orthogonal Arrow"; activated => { root.command("arrow-orthogonal"); } }
            MenuItem { title: "Link Middles"; activated => { root.command("link-middles"); } }
            MenuItem { title: "Unlink Middles"; activated => { root.command("unlink-middles"); } }
            MenuItem { title: "Delete Node or Arrow"; activated => { root.command("delete"); } }
        }
        Menu {
            title: "View";
            MenuItem { title: "Zoom In"; shortcut: @keys(Control + Equals); activated => { root.command("zoom-in"); } }
            MenuItem { title: "Zoom Out"; shortcut: @keys(Control + HyphenMinus); activated => { root.command("zoom-out"); } }
            MenuItem { title: "Actual Size"; shortcut: @keys(Control + Digit0); activated => { root.command("zoom-100"); } }
            MenuItem { title: "Zoom to Fit"; shortcut: @keys(Control + F); activated => { root.command("zoom-fit"); } }
            MenuSeparator {}
            MenuItem { title: "Reset View"; activated => { root.command("reset-view"); } }
        }
        Menu {
            title: "Page";
            MenuItem { title: "New Page"; shortcut: @keys(Control + T); activated => { root.page-action("add", -1); } }
            MenuItem { title: "Duplicate Page"; activated => { root.page-action("duplicate", -1); } }
            MenuItem { title: "Rename Page"; shortcut: @keys(F2); activated => { root.page-action("rename", -1); } }
            MenuItem { title: "Delete Page"; activated => { root.page-action("delete", -1); } }
            MenuSeparator {}
            // Ctrl+PgUp/PgDn are handled by the canvas key handler.
            MenuItem { title: "Next Page (Ctrl+PgDn)"; activated => { root.page-action("next", -1); } }
            MenuItem { title: "Previous Page (Ctrl+PgUp)"; activated => { root.page-action("prev", -1); } }
            MenuItem { title: "Move Page Left"; activated => { root.page-action("move-left", -1); } }
            MenuItem { title: "Move Page Right"; activated => { root.page-action("move-right", -1); } }
        }
    }

    VerticalLayout {
        // Toolbar / ribbon row.
        Rectangle {
            background: #ececea;
            height: 38px;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 2px;
                alignment: start;
                padding-top: 4px;
                padding-bottom: 4px;
                ToolButton { icon: @image-url("icons/new.svg"); tip: "New"; clicked => { root.command("new"); } }
                ToolButton { icon: @image-url("icons/open.svg"); tip: "Open"; clicked => { root.command("open"); } }
                ToolButton { icon: @image-url("icons/save.svg"); tip: "Save"; clicked => { root.command("save"); } }
                Rectangle { width: 9px; Rectangle { x: 4px; y: 4px; width: 1px; height: parent.height - 8px; background: #c4c4c0; } }
                ToolButton { icon: @image-url("icons/undo.svg"); tip: "Undo"; clicked => { root.command("undo"); } }
                ToolButton { icon: @image-url("icons/redo.svg"); tip: "Redo"; clicked => { root.command("redo"); } }
                Rectangle { width: 9px; Rectangle { x: 4px; y: 4px; width: 1px; height: parent.height - 8px; background: #c4c4c0; } }
                ToolButton { icon: @image-url("icons/add-node.svg"); tip: "Add node"; clicked => { root.command("add-node"); } }
                ToolButton { icon: @image-url("icons/add-table.svg"); tip: "Add table"; clicked => { root.command("add-table"); } }
                ToolButton { icon: @image-url("icons/arrow-straight.svg"); tip: "Straight arrow: click two attachment points; changes selected arrow"; clicked => { root.command("arrow-straight"); } }
                ToolButton { icon: @image-url("icons/arrow-orthogonal.svg"); tip: "Orthogonal arrow: click two attachment points; changes selected arrow"; clicked => { root.command("arrow-orthogonal"); } }
                ToolButton { active: root.connect-mode == 3; icon: @image-url("icons/link.svg"); tip: "Link middles: click two parallel orthogonal middle segments"; clicked => { root.command("link-middles"); } }
                ToolButton { icon: @image-url("icons/unlink.svg"); tip: "Unlink middles of selected arrow"; clicked => { root.command("unlink-middles"); } }
                ToolButton { icon: @image-url("icons/delete.svg"); tip: "Delete node or arrow"; clicked => { root.command("delete"); } }
                Rectangle { width: 9px; Rectangle { x: 4px; y: 4px; width: 1px; height: parent.height - 8px; background: #c4c4c0; } }
                ToolButton { icon: @image-url("icons/zoom-in.svg"); tip: "Zoom in"; clicked => { root.command("zoom-in"); } }
                ToolButton { icon: @image-url("icons/zoom-out.svg"); tip: "Zoom out"; clicked => { root.command("zoom-out"); } }
                ToolButton { icon: @image-url("icons/zoom-100.svg"); tip: "Actual size"; clicked => { root.command("zoom-100"); } }
                ToolButton { icon: @image-url("icons/zoom-fit.svg"); tip: "Zoom to fit"; clicked => { root.command("zoom-fit"); } }
            }
        }

        canvas := Rectangle {
            background: #f4f4f2;
            clip: true;

            keys := FocusScope {
                changed has-focus => {
                    if (!self.has-focus) {
                        root.space-pan = false;
                    }
                }
                key-released(e) => {
                    if (e.text == " ") {
                        root.space-pan = false;
                        return accept;
                    }
                    reject
                }
                key-pressed(e) => {
                    if (e.text == " ") {
                        root.space-pan = true;
                        return accept;
                    }
                    if (e.text == Key.Escape && bg.drag-mode == 2) {
                        bg.drag-mode = 3;
                        root.marquee-cancel();
                        return accept;
                    }
                    // Also reached from inside the node editor, whose unhandled
                    // keys bubble up here; page-action commits it first.
                    if (e.modifiers.control && e.text == Key.PageDown) {
                        root.page-action("next", -1);
                        return accept;
                    }
                    if (e.modifiers.control && e.text == Key.PageUp) {
                        root.page-action("prev", -1);
                        return accept;
                    }
                    if (root.key(e.text, e.modifiers.control, e.modifiers.shift)) {
                        return accept;
                    }
                    reject
                }

                // Tracks the mouse for Ctrl+V. A TouchArea sees pointer moves
                // before its children, so this follows the mouse over nodes as
                // well as the background; the children handle the events.
                tracker := TouchArea {
                    bg := TouchArea {
                        property <length> start-pan-x;
                        property <length> start-pan-y;
                        property <bool> over-arrow;
                        // 0 pressed, 1 Shift held but under the drag threshold,
                        // 2 selection rectangle, 3 rectangle cancelled with Escape,
                        // 4 panned. Only 0 and 1 count as a click on release.
                        property <int> drag-mode;
                        property <length> m-x0;
                        property <length> m-y0;
                        property <length> m-x1;
                        property <length> m-y1;
                        // Canvas point the background menu was opened on.
                        property <length> menu-x;
                        property <length> menu-y;
                        mouse-cursor: self.drag-mode == 2 ? crosshair : self.over-arrow ? pointer : default;
                        changed mouse-x => { self.hover(); }
                        changed mouse-y => { self.hover(); }
                        changed has-hover => { self.hover(); }
                        changed pressed => { self.hover(); }
                        function hover() {
                            self.over-arrow = root.canvas-pointer(
                                (self.mouse-x - root.pan-x) / root.zoom,
                                (self.mouse-y - root.pan-y) / root.zoom,
                                self.has-hover && !self.pressed);
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.middle) {
                                root.command("zoom-fit");
                            }
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                self.start-pan-x = root.pan-x;
                                self.start-pan-y = root.pan-y;
                                self.drag-mode = e.modifiers.shift ? 1 : 0;
                                self.m-x0 = (self.mouse-x - root.pan-x) / root.zoom;
                                self.m-y0 = (self.mouse-y - root.pan-y) / root.zoom;
                                keys.focus();
                            }
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && self.drag-mode == 2) {
                                root.marquee-end(self.m-x0, self.m-y0, self.m-x1, self.m-y1, e.modifiers.control);
                            }
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                self.menu-x = (self.mouse-x - root.pan-x) / root.zoom;
                                self.menu-y = (self.mouse-y - root.pan-y) / root.zoom;
                                bg-menu.show({ x: self.mouse-x, y: self.mouse-y });
                            }
                        }
                        moved => {
                            if (self.drag-mode == 0 && max(abs(self.mouse-x - self.pressed-x), abs(self.mouse-y - self.pressed-y)) > 4px) {
                                self.drag-mode = 4;
                            }
                            if (self.drag-mode == 0 || self.drag-mode == 4) {
                                root.pan-x = self.start-pan-x + (self.mouse-x - self.pressed-x);
                                root.pan-y = self.start-pan-y + (self.mouse-y - self.pressed-y);
                            }
                            if (self.drag-mode == 1 && max(abs(self.mouse-x - self.pressed-x), abs(self.mouse-y - self.pressed-y)) > 4px) {
                                self.drag-mode = 2;
                            }
                            if (self.drag-mode == 2) {
                                self.m-x1 = (self.mouse-x - root.pan-x) / root.zoom;
                                self.m-y1 = (self.mouse-y - root.pan-y) / root.zoom;
                                root.marquee-update(self.m-x0, self.m-y0, self.m-x1, self.m-y1);
                            }
                        }
                        clicked => {
                            // A pan or a finished or cancelled rectangle is not a click.
                            if (self.drag-mode < 2) {
                                root.background-clicked((self.mouse-x - root.pan-x) / root.zoom, (self.mouse-y - root.pan-y) / root.zoom);
                                keys.focus();
                            }
                        }
                        double-clicked => {
                            root.background-double-clicked(
                                (self.mouse-x - root.pan-x) / root.zoom,
                                (self.mouse-y - root.pan-y) / root.zoom);
                        }
                        scroll-event(e) => {
                            if (e.modifiers.control) {
                                root.zoom-at(
                                    clamp(root.zoom * (e.delta-y > 0 ? 1.1 : 1 / 1.1), 0.1, 8) / root.zoom,
                                    self.mouse-x, self.mouse-y);
                            } else if (e.modifiers.shift) {
                                root.pan-x += e.delta-y + e.delta-x;
                            } else {
                                root.pan-x += e.delta-x;
                                root.pan-y += e.delta-y;
                            }
                            accept
                        }
                    }
                    // Shown by the background's right-click handler, which
                    // records where the paste goes; zero-sized so it takes no
                    // clicks itself.
                    bg-menu := ContextMenuArea {
                        x: 0; y: 0; width: 0; height: 0;
                        Menu {
                            MenuItem { title: "Paste here"; activated => { root.paste-at(bg.menu-x, bg.menu-y); } }
                        }
                    }

                    // Path reserves half its stroke on each side. Compensate so
                    // its viewbox maps exactly to canvas coordinates.
                    for arrow in root.arrows : Rectangle {
                        // Hover halo: a fixed screen width, so it stays visible
                        // when zoomed out.
                        if arrow.hovered : Path {
                            x: root.pan-x + arrow.x * root.zoom - 5px;
                            y: root.pan-y + arrow.y * root.zoom - 5px;
                            width: arrow.w * root.zoom + 10px;
                            height: arrow.h * root.zoom + 10px;
                            commands: arrow.commands;
                            viewbox-width: arrow.w / 1px;
                            viewbox-height: arrow.h / 1px;
                            fill: transparent;
                            stroke: #3b82f650;
                            stroke-width: 10px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                        Path {
                            x: root.pan-x + (arrow.x - 1px) * root.zoom;
                            y: root.pan-y + (arrow.y - 1px) * root.zoom;
                            width: (arrow.w + 2px) * root.zoom;
                            height: (arrow.h + 2px) * root.zoom;
                            commands: arrow.commands;
                            viewbox-width: arrow.w / 1px;
                            viewbox-height: arrow.h / 1px;
                            fill: transparent;
                            stroke: arrow.color;
                            stroke-width: 2px * root.zoom;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                    }

                    // Node geometry is snapped to whole physical pixels. The SVG
                    // is rasterized at the element's pixel size, and a fractional
                    // position or size makes the GPU resample it, which blurs text.
                    for n[i] in root.nodes : node := Rectangle {
                        x: round((root.pan-x + n.x * root.zoom) / 1phx) * 1phx;
                        y: round((root.pan-y + n.y * root.zoom) / 1phx) * 1phx;
                        width: round(n.w * root.zoom / 1phx) * 1phx;
                        height: round(n.h * root.zoom / 1phx) * 1phx;
                        background: white;
                        border-width: n.selected || n.marquee || body.has-hover || handle.has-hover ? 2px : 1px;
                        border-color: n.selected ? #3b82f6 : n.marquee || body.has-hover || handle.has-hover ? #93c5fd : #c8c8c8;
                        border-radius: 3px;
                        clip: true;

                        Image {
                            source: n.img;
                            x: 0; y: 0;
                            width: parent.width;
                            height: parent.height;
                            image-fit: fill;
                        }
                        if n.error != "" : Text {
                            x: 6px; y: 6px;
                            width: parent.width - 12px;
                            text: n.error;
                            color: #b00020;
                            wrap: word-wrap;
                            font-size: 11px * root.zoom;
                        }
                        // Drag. Mouse positions are measured in canvas coordinates
                        // (node.x + local mouse-x), not in this TouchArea's own
                        // coordinates, because the TouchArea moves with the node
                        // while dragging, which would feed back into the delta.
                        body := TouchArea {
                            property <length> start-x;
                            property <length> start-y;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.middle) {
                                    root.command("zoom-fit");
                                }
                                if (e.button != PointerEventButton.left) {
                                    return;
                                }
                                if (e.kind == PointerEventKind.down) {
                                    self.start-x = node.x + self.mouse-x;
                                    self.start-y = node.y + self.mouse-y;
                                    root.node-pressed(i, e.modifiers.control);
                                    keys.focus();
                                }
                                if (e.kind == PointerEventKind.up) {
                                    root.node-drag-end(i);
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.node-drag(i,
                                        (node.x + self.mouse-x - self.start-x) / root.zoom,
                                        (node.y + self.mouse-y - self.start-y) / root.zoom);
                                }
                            }
                            double-clicked => {
                                root.node-edit-request(i);
                            }
                        }
                        ContextMenuArea {
                            Menu {
                                MenuItem { title: "Edit"; activated => { root.node-menu("edit", i); } }
                                MenuItem { title: "Copy"; activated => { root.node-menu("copy", i); } }
                                MenuItem { title: "Copy as Typst"; activated => { root.node-menu("copy-typst", i); } }
                                MenuSeparator {}
                                MenuItem { title: "Delete"; activated => { root.node-menu("delete", i); } }
                            }
                        }
                        // Width resize handle. Same canvas-coordinate trick: the
                        // handle sits at the right edge and moves as the width changes.
                        handle := TouchArea {
                            property <length> start-x;
                            x: parent.width - 12px;
                            y: parent.height - 12px;
                            width: 12px;
                            height: 12px;
                            mouse-cursor: ew-resize;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.middle) {
                                    root.command("zoom-fit");
                                }
                                if (e.button != PointerEventButton.left) {
                                    return;
                                }
                                if (e.kind == PointerEventKind.down) {
                                    self.start-x = node.x + self.x + self.mouse-x;
                                }
                                if (e.kind == PointerEventKind.up) {
                                    root.node-resize-end(i);
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.node-resize(i, (node.x + self.x + self.mouse-x - self.start-x) / root.zoom);
                                }
                            }
                            Rectangle {
                                x: 4px; y: 4px; width: 6px; height: 6px;
                                background: n.selected || handle.has-hover ? #3b82f6 : #bbbbbb;
                            }
                        }
                    }

                    // Ports sit above nodes so the full target remains clickable.
                    for n[i] in root.nodes : Rectangle {
                        visible: root.connect-mode == 1 || root.connect-mode == 2;
                        x: root.pan-x + n.x * root.zoom;
                        y: root.pan-y + n.y * root.zoom;
                        width: n.w * root.zoom;
                        height: n.h * root.zoom;
                        for side in 4 : Rectangle {
                            x: (side == 1 ? parent.width : side == 3 ? 0px : parent.width / 2) - 6px;
                            y: (side == 2 ? parent.height : side == 0 ? 0px : parent.height / 2) - 6px;
                            width: 12px; height: 12px;
                            border-radius: 6px;
                            background: port.has-hover ? #2563eb : white;
                            border-width: 2px;
                            border-color: #2563eb;
                            port := TouchArea {
                                mouse-cursor: crosshair;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.middle) {
                                        root.command("zoom-fit");
                                    }
                                }
                                clicked => { root.port-clicked(i, side); keys.focus(); }
                            }
                        }
                    }

                    // Dragging right selects nodes fully inside (blue); dragging
                    // left selects any node the rectangle touches (green), as in CAD.
                    if bg.drag-mode == 2 && bg.pressed : Rectangle {
                        property <bool> crossing: bg.m-x1 < bg.m-x0;
                        x: root.pan-x + min(bg.m-x0, bg.m-x1) * root.zoom;
                        y: root.pan-y + min(bg.m-y0, bg.m-y1) * root.zoom;
                        width: abs(bg.m-x1 - bg.m-x0) * root.zoom;
                        height: abs(bg.m-y1 - bg.m-y0) * root.zoom;
                        background: self.crossing ? #16a34a1a : #3b82f61a;
                        border-width: 1px;
                        border-color: self.crossing ? #16a34a : #3b82f6;
                    }

                    if root.connect-mode == 3 : Rectangle {
                        // The wide band is the actual landing range: 36 screen px.
                        for segment[i] in root.link-segments : Rectangle {
                            x: root.pan-x + segment.x * root.zoom - 18px;
                            y: root.pan-y + segment.y * root.zoom - 18px;
                            width: segment.w * root.zoom + 36px;
                            height: segment.h * root.zoom + 36px;
                            border-radius: 18px;
                            background: i == root.link-hover ? (segment.eligible ? #4ade8030 : #ef444430) : segment.eligible ? #3b82f610 : transparent;
                            Rectangle {
                                x: segment.w == 0px ? (parent.width - self.width) / 2 : 18px;
                                y: segment.h == 0px ? (parent.height - self.height) / 2 : 18px;
                                width: max(segment.w * root.zoom, i == root.link-hover || segment.selected ? 8px : 5px);
                                height: max(segment.h * root.zoom, i == root.link-hover || segment.selected ? 8px : 5px);
                                border-radius: 4px;
                                background: segment.selected ? #9333ea : i == root.link-hover ? (segment.eligible ? #16a34a : #dc2626) : segment.eligible ? #3b82f680 : transparent;
                            }
                        }
                        // Paint the hovered segment last so coincident candidates
                        // cannot obscure which arrow the next click will choose.
                        if root.link-hover >= 0 : Rectangle {
                            property <LinkSegmentVm> segment: root.link-segments[root.link-hover];
                            x: root.pan-x + self.segment.x * root.zoom - (self.segment.w == 0px ? 4px : 0px);
                            y: root.pan-y + self.segment.y * root.zoom - (self.segment.h == 0px ? 4px : 0px);
                            width: max(self.segment.w * root.zoom, 8px);
                            height: max(self.segment.h * root.zoom, 8px);
                            border-radius: 4px;
                            background: self.segment.eligible ? #16a34a : #dc2626;
                        }
                        link-area := TouchArea {
                            mouse-cursor: root.link-hover >= 0 && root.link-segments[root.link-hover].eligible ? pointer : not-allowed;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.middle) {
                                    root.command("zoom-fit");
                                }
                            }
                            changed mouse-x => {
                                root.link-pointer((self.mouse-x - root.pan-x) / root.zoom, (self.mouse-y - root.pan-y) / root.zoom, self.has-hover);
                            }
                            changed mouse-y => {
                                root.link-pointer((self.mouse-x - root.pan-x) / root.zoom, (self.mouse-y - root.pan-y) / root.zoom, self.has-hover);
                            }
                            changed has-hover => {
                                root.link-pointer((self.mouse-x - root.pan-x) / root.zoom, (self.mouse-y - root.pan-y) / root.zoom, self.has-hover);
                            }
                            clicked => {
                                root.background-clicked((self.mouse-x - root.pan-x) / root.zoom, (self.mouse-y - root.pan-y) / root.zoom);
                                keys.focus();
                            }
                            scroll-event(e) => {
                                if (e.modifiers.control) {
                                    root.zoom-at(clamp(root.zoom * (e.delta-y > 0 ? 1.1 : 1 / 1.1), 0.1, 8) / root.zoom, self.mouse-x, self.mouse-y);
                                } else {
                                    root.pan-x += e.delta-x;
                                    root.pan-y += e.delta-y;
                                }
                                root.link-pointer((self.mouse-x - root.pan-x)/root.zoom,(self.mouse-y - root.pan-y)/root.zoom,true);
                                accept
                            }
                        }
                        Rectangle {
                            x: max(8px, (parent.width - self.width) / 2);
                            y: 12px;
                            width: min(640px, parent.width - 16px);
                            height: 120px;
                            background: #eff6ff;
                            border-width: 2px;
                            border-color: #3b82f6;
                            border-radius: 8px;
                            TouchArea { } // Keep banner clicks off the canvas.
                            Text {
                                x: 16px; y: 10px; height: 24px;
                                text: root.link-step == 1 ? "Link middles · Step 1 of 2: choose the first segment" : "Link middles · Step 2 of 2: choose the second segment";
                                font-weight: 700; color: #1e3a8a;
                            }
                            Text {
                                x: 16px; y: 36px; width: parent.width - 32px; height: 28px;
                                text: root.link-hint; font-size: 12px;
                                color: root.link-hover >= 0 ? (root.link-segments[root.link-hover].eligible ? #15803d : #b91c1c) : #334155;
                                wrap: word-wrap;
                            }
                            Text { x: 16px; y: 96px; text: "Blue: available   Purple: first selection   Green: ready to click"; font-size: 11px; color: #475569; }
                            if root.link-step == 2 : Rectangle {
                                x: parent.width - 154px; y: 68px; width: 62px; height: 25px;
                                background: #dbeafe; border-radius: 4px;
                                Text { text: "Back"; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.command("restart-link"); } }
                            }
                            Rectangle {
                                x: parent.width - 84px; y: 68px; width: 72px; height: 25px;
                                background: #dbeafe; border-radius: 4px;
                                Text { text: "Cancel"; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.command("cancel-link"); } }
                            }
                        }
                    }

                    // Space held: drag anywhere to pan, even over nodes and arrows.
                    if root.space-pan : TouchArea {
                        property <length> start-pan-x;
                        property <length> start-pan-y;
                        mouse-cursor: self.pressed ? grabbing : grab;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.middle) {
                                root.command("zoom-fit");
                            }
                            if (e.kind == PointerEventKind.down) {
                                self.start-pan-x = root.pan-x;
                                self.start-pan-y = root.pan-y;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.pan-x = self.start-pan-x + (self.mouse-x - self.pressed-x);
                                root.pan-y = self.start-pan-y + (self.mouse-y - self.pressed-y);
                            }
                        }
                    }
                }

                editor := Rectangle {
                    visible: root.edit-index >= 0;
                    x: root.edit-index >= 0 ? root.pan-x + root.nodes[root.edit-index].x * root.zoom : 0;
                    y: root.edit-index >= 0 ? root.pan-y + root.nodes[root.edit-index].y * root.zoom : 0;
                    width: root.edit-index >= 0 ? max(root.nodes[root.edit-index].w * root.zoom, 320px) : 0;
                    // Grow with the text so the caret never runs off the bottom.
                    height: root.edit-index >= 0 ? max(root.nodes[root.edit-index].h * root.zoom, 160px, edit-input.preferred-height + 24px) : 0;
                    background: #fffbe6;
                    border-color: #e0a800;
                    border-width: 2px;
                    border-radius: 3px;
                    clip: true;

                    edit-input := TextInput {
                        x: 8px; y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;
                        single-line: false;
                        wrap: word-wrap;
                        font-family: "monospace";
                        font-size: 13px;
                        color: #222;
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                root.cancel-edit();
                                return accept;
                            }
                            if (e.text == Key.Return && e.modifiers.control) {
                                root.commit-edit(root.edit-index, self.text);
                                return accept;
                            }
                            reject
                        }
                    }
                }

                // Grid editor for table nodes. Cells are positioned from their
                // grid coordinates; the width is split evenly between columns.
                table-editor := Rectangle {
                    property <length> cell-h: 30px;
                    property <length> pad: 8px;
                    // Canvas units to editor pixels.
                    property <length> unit: 1px * root.zoom;
                    visible: root.table-edit-index >= 0;
                    x: root.table-edit-index >= 0 ? root.pan-x + root.nodes[root.table-edit-index].x * root.zoom : 0;
                    y: root.table-edit-index >= 0 ? root.pan-y + root.nodes[root.table-edit-index].y * root.zoom : 0;
                    width: root.table-width * unit + 2 * pad;
                    height: root.table-rows * cell-h + 2 * pad + 20px;
                    background: #fffbe6;
                    border-color: #e0a800;
                    border-width: 2px;
                    border-radius: 3px;
                    clip: true;

                    table-keys := FocusScope {
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                root.cancel-table-edit();
                                return accept;
                            }
                            if (e.text == Key.Return && e.modifiers.control) {
                                root.commit-table-edit();
                                return accept;
                            }
                            reject
                        }

                        for cell[k] in root.edit-cells : Rectangle {
                            x: table-editor.pad + cell.x * table-editor.unit;
                            y: table-editor.pad + cell.r * table-editor.cell-h;
                            width: cell.w * table-editor.unit;
                            height: table-editor.cell-h;
                            background: cell.fill;
                            border-width: 1px;
                            border-color: #d8cf9c;

                            TextInput {
                                x: 5px;
                                width: parent.width - 10px;
                                height: parent.height;
                                vertical-alignment: center;
                                single-line: true;
                                text: cell.text;
                                font-size: 13px;
                                font-weight: cell.header ? 700 : 400;
                                color: #222;
                                edited => { root.table-cell-edited(k, self.text); }
                                key-pressed(e) => {
                                    if (e.text == Key.Escape) {
                                        root.cancel-table-edit();
                                        return accept;
                                    }
                                    if (e.text == Key.Return && e.modifiers.control) {
                                        root.commit-table-edit();
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            ContextMenuArea {
                                Menu {
                                    MenuItem { title: "Insert row above"; activated => { root.table-op("row-above", k); } }
                                    MenuItem { title: "Insert row below"; activated => { root.table-op("row-below", k); } }
                                    MenuItem { title: "Delete row"; activated => { root.table-op("row-delete", k); } }
                                    MenuSeparator {}
                                    MenuItem { title: "Insert column left"; activated => { root.table-op("col-left", k); } }
                                    MenuItem { title: "Insert column right"; activated => { root.table-op("col-right", k); } }
                                    MenuItem { title: "Delete column"; activated => { root.table-op("col-delete", k); } }
                                    MenuSeparator {}
                                    Menu {
                                        title: "Column align";
                                        MenuItem { title: "Left"; activated => { root.table-op("align:left", k); } }
                                        MenuItem { title: "Center"; activated => { root.table-op("align:center", k); } }
                                        MenuItem { title: "Right"; activated => { root.table-op("align:right", k); } }
                                        MenuItem { title: "Auto"; activated => { root.table-op("align:auto", k); } }
                                    }
                                    Menu {
                                        title: "Column width";
                                        MenuItem { title: "Auto (fit content)"; activated => { root.table-op("col-track:auto", k); } }
                                        MenuItem { title: "Fill remaining (1fr)"; activated => { root.table-op("col-track:1fr", k); } }
                                        MenuItem { title: "Fill double share (2fr)"; activated => { root.table-op("col-track:2fr", k); } }
                                    }
                                    Menu {
                                        title: "Cell fill";
                                        MenuItem { title: "None"; activated => { root.table-op("fill:", k); } }
                                        MenuItem { title: "Gray"; activated => { root.table-op("fill:#e5e7eb", k); } }
                                        MenuItem { title: "Yellow"; activated => { root.table-op("fill:#fef3c7", k); } }
                                        MenuItem { title: "Green"; activated => { root.table-op("fill:#d1fae5", k); } }
                                        MenuItem { title: "Blue"; activated => { root.table-op("fill:#dbeafe", k); } }
                                        MenuItem { title: "Red"; activated => { root.table-op("fill:#fee2e2", k); } }
                                        MenuItem { title: "Purple"; activated => { root.table-op("fill:#ede9fe", k); } }
                                    }
                                    Menu {
                                        title: "Row fill";
                                        MenuItem { title: "None"; activated => { root.table-op("row-fill:", k); } }
                                        MenuItem { title: "Gray"; activated => { root.table-op("row-fill:#e5e7eb", k); } }
                                        MenuItem { title: "Yellow"; activated => { root.table-op("row-fill:#fef3c7", k); } }
                                        MenuItem { title: "Green"; activated => { root.table-op("row-fill:#d1fae5", k); } }
                                        MenuItem { title: "Blue"; activated => { root.table-op("row-fill:#dbeafe", k); } }
                                        MenuItem { title: "Red"; activated => { root.table-op("row-fill:#fee2e2", k); } }
                                        MenuItem { title: "Purple"; activated => { root.table-op("row-fill:#ede9fe", k); } }
                                    }
                                    MenuSeparator {}
                                    MenuItem { title: "Toggle header row"; activated => { root.table-op("header-toggle", k); } }
                                }
                            }
                        }

                        // Column dividers. Dragging one fixes that column's
                        // width in points. Positions are measured against the
                        // static FocusScope so the handle moving under the
                        // pointer does not feed back into the delta.
                        for edge in root.edit-col-edges : TouchArea {
                            property <length> start-x;
                            x: table-editor.pad + edge.x * table-editor.unit - 4px;
                            y: table-editor.pad;
                            width: 8px;
                            height: root.table-rows * table-editor.cell-h;
                            mouse-cursor: col-resize;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    self.start-x = self.x + self.mouse-x;
                                    root.table-col-resize-start(edge.col);
                                }
                                if (e.kind == PointerEventKind.up) {
                                    root.table-col-resize-end();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.table-col-resize(edge.col, (self.x + self.mouse-x - self.start-x) / table-editor.unit);
                                }
                            }
                            Rectangle {
                                x: 3px;
                                width: 2px;
                                height: parent.height;
                                background: parent.has-hover || parent.pressed ? #e0a800 : transparent;
                            }
                        }

                        Text {
                            x: table-editor.pad;
                            y: table-editor.height - 20px;
                            text: "Ctrl+Enter save   Esc cancel   right-click a cell for rows, columns, width, fill   drag dividers to resize";
                            font-size: 11px;
                            color: #8a7a2a;
                        }
                    }
                }
            }
        }
        // Page tabs, attached to the bottom of the canvas like sheet tabs.
        Rectangle {
            height: 28px;
            background: #dcdcd8;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-bottom: 3px;
                spacing: 2px;
                alignment: start;
                for p[i] in root.pages : Rectangle {
                    background: p.active ? #f4f4f2 : tab-ta.has-hover ? #e8e8e5 : #d0d0cc;
                    border-radius: 3px;
                    tab-ta := TouchArea {
                        clicked => { root.page-action("select", i); }
                        double-clicked => { root.page-action("rename", i); }
                    }
                    ContextMenuArea {
                        Menu {
                            MenuItem { title: "Rename"; activated => { root.page-action("rename", i); } }
                            MenuItem { title: "Duplicate"; activated => { root.page-action("duplicate", i); } }
                            MenuSeparator {}
                            MenuItem { title: "Move left"; activated => { root.page-action("move-left", i); } }
                            MenuItem { title: "Move right"; activated => { root.page-action("move-right", i); } }
                            MenuSeparator {}
                            MenuItem { title: "Delete"; activated => { root.page-action("delete", i); } }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        if root.rename-page != i : Text {
                            text: p.name;
                            vertical-alignment: center;
                            font-weight: p.active ? 600 : 400;
                            color: #333;
                        }
                        if root.rename-page == i : TextInput {
                            text: p.name;
                            min-width: 80px;
                            vertical-alignment: center;
                            single-line: true;
                            color: #222;
                            init => {
                                self.focus();
                                self.select-all();
                            }
                            accepted => { root.page-renamed(i, self.text); }
                            // Clicking elsewhere keeps the new name. Escape
                            // clears rename-page first, so this skips it.
                            changed has-focus => {
                                if (!self.has-focus && root.rename-page == i) {
                                    root.page-renamed(i, self.text);
                                }
                            }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.rename-page = -1;
                                    root.focus-canvas();
                                    return accept;
                                }
                                reject
                            }
                        }
                    }
                }
                Rectangle {
                    width: 24px;
                    border-radius: 3px;
                    background: add-ta.has-hover ? #e8e8e5 : transparent;
                    add-ta := TouchArea {
                        clicked => { root.page-action("add", -1); }
                    }
                    Text {
                        text: "+";
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: #444;
                    }
                    Tooltip {
                        text: @markdown("New page (Ctrl+T)");
                    }
                }
            }
        }
        Rectangle {
            height: 24px;
            background: #e6e6e3;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: root.status-left;
                    vertical-alignment: center;
                    color: #333;
                }
                Text {
                    text: root.status-right;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: #333;
                }
            }
        }
    }
}
